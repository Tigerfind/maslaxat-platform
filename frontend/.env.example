# Browser runtime telemetry. Use a dedicated frontend Sentry project.
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENVIRONMENT=production
# Must equal the deployed Railway commit SHA.
REACT_APP_SENTRY_RELEASE=

# Private build-only source-map upload settings. Never expose the auth token as REACT_APP_*.
SENTRY_SOURCE_MAPS_ENABLED=0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_FRONTEND_PROJECT=
RAILWAY_GIT_COMMIT_SHA=
