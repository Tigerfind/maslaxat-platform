VITE_API_URL=http://localhost:3001/api

# Browser runtime telemetry. Use a dedicated frontend Sentry project.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
# Must equal the deployed Railway commit SHA.
VITE_SENTRY_RELEASE=

# Private build-only source-map upload settings. Never expose the auth token as VITE_*.
SENTRY_SOURCE_MAPS_ENABLED=0
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_FRONTEND_PROJECT=
RAILWAY_GIT_COMMIT_SHA=
