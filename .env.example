# Database Configuration
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/maslaxat
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Payment System Configuration
PAYME_MERCHANT_ID=your-payme-merchant-id
PAYME_SECRET_KEY=your-payme-secret-key
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SECRET_KEY=your-click-secret-key
UZCARD_MERCHANT_ID=your-uzcard-merchant-id
UZCARD_SECRET_KEY=your-uzcard-secret-key

# Email Service Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@maslaxat.uz
FROM_NAME=MaslaXat Platform

# File Storage Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=your-aws-region
AWS_BUCKET_NAME=maslaxat-files
AWS_S3_ENDPOINT=https://s3.amazonaws.com

# Video Service Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_API_KEY=your-twilio-api-key
TWILIO_API_SECRET=your-twilio-api-secret

# SMS Service Configuration
SMS_PROVIDER=eskiz
SMS_API_KEY=your-sms-api-key
SMS_FROM=MaslaXat

# Push Notifications
FCM_SERVER_KEY=your-firebase-server-key
FCM_SENDER_ID=your-firebase-sender-id
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_BUNDLE_ID=com.maslaxat.app

# Security Configuration
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Application Configuration
NODE_ENV=development
PORT=8080
API_VERSION=v1
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:8080

# Monitoring and Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-new-relic-key

# Feature Flags
ENABLE_2FA=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_VIDEO_RECORDING=true
ENABLE_AI_ASSISTANT=true
ENABLE_PAYMENT_SYSTEMS=true
ENABLE_NOTIFICATIONS=true
ENABLE_ANALYTICS=true

# Performance Configuration
CACHE_TTL=3600
MAX_FILE_SIZE=10485760
MAX_CONCURRENT_CONNECTIONS=1000
DB_POOL_SIZE=20

# Legal Configuration
LEGAL_JURISDICTION=Uzbekistan
LEGAL_CURRENCY=UZS
LEGAL_TIMEZONE=Asia/Tashkent
LEGAL_LANGUAGES=uz,ru,en