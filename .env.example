# ============================================================
# MaslaXat backend/api — пример настроек (.env)
# Скопируй этот файл в backend/api/.env и заполни значения.
# Curated supported operator variables for local and production setup.
# Internal test/workflow-only variables are intentionally not exhaustive here.
# ============================================================

# --- База данных (PostgreSQL) ---
# В production: либо DATABASE_URL, либо полный DB_* tuple.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=emaslaxat
DB_USER=postgres
DB_PASSWORD=
# 1 enables TLS when DATABASE_URL does not already use sslmode=require; default 0.
DB_SSL=0
# Advisory migration lock: wait 0..600000 ms; poll 1..10000 ms.
MIGRATION_LOCK_WAIT_MS=120000
MIGRATION_LOCK_POLL_MS=1000
MIGRATION_BACKUP_EVIDENCE_B64=
MIGRATION_BACKUP_EVIDENCE_SIGNATURE_B64=
MIGRATION_BACKUP_EVIDENCE_PUBLIC_KEY_B64=
MIGRATION_BACKUP_EVIDENCE_KEY_ID=
MIGRATION_BACKUP_EXPECTED_CLUSTER_ID=
MIGRATION_BACKUP_MAX_AGE_SECONDS=3600

# --- Redis (кэш, rate-limit; необязателен — код деградирует без него) ---
REDIS_URL=redis://localhost:6379
# 1 enables the Socket.IO Redis adapter for multi-replica deployments; default 0.
SOCKET_REDIS=0

# --- Режим и порт бэкенда ---
NODE_ENV=development
PORT=3001

# --- Адрес фронтенда (для ссылок в письмах: сброс пароля, верификация) ---
FRONTEND_URL=http://localhost:3000

# --- CORS: каким адресам фронта разрешено обращаться к API (через запятую) ---
CORS_ORIGINS=http://localhost:3000

# --- JWT (авторизация) ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Приватный R2 (в production обязателен; account id = ровно 32 hex) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_AI_TEMP_LIFECYCLE_DAYS=1
# Stable secret used only to sign resumable storage-migration checkpoints (minimum 32 chars).
STORAGE_MIGRATION_CHECKPOINT_KEY=
FILE_STORAGE_WRITE_MODE=r2
FILE_STORAGE_LOCAL_FALLBACK=false
FILE_STORAGE_LOCAL_ROOT=/data/uploads

# --- Независимые production-секреты каталога (>=32 символов, не JWT и не друг друга) ---
CATALOG_CURSOR_SECRET=
CATALOG_ATTRIBUTION_SECRET=
# 1 requires cross-site HTTPS cookies (SameSite=None); default 0 uses Lax.
CATALOG_COOKIE_CROSS_SITE=0

# --- ИИ (Claude / Anthropic). Пусто = ИИ работает в запасном (fallback) режиме ---
ANTHROPIC_API_KEY=

# --- Backend Sentry (отдельный проект; пустой DSN = отправка отключена) ---
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=development
# Railway release identity is declared once in the authorization section below.

# --- Оплата Payme (получить на merchant.payme.uz). Пусто = оплата недоступна ---
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYMENT_V2_MODE=legacy
# Shadow использует PAYME_*; ключи подписи evidence никогда не передаются приложению.
# Active отклоняется. Подготовка evidence описана в docs/runbooks/payme-cutover.md.

# --- Почта SMTP. Пусто = в dev используется тестовый Ethereal (письма не доходят) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
# true только для явно требуемого STARTTLS при SMTP_SECURE=false.
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- TURN (необязательно, но tuple всегда заполняется целиком) ---
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Web push и social (необязательные атомарные tuples) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
GOOGLE_CLIENT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Загрузка файлов ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# --- Rate limiting (ограничение частоты запросов) ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# Positive integer. Development default is 100; production default is 20.
AUTH_RATE_LIMIT_MAX=100

# --- Authorization cutover (compatibility remains the default/refusal-safe mode) ---
AUTHORIZATION_MODE=compatibility
# Production requires the complete provider runtime identity tuple. Commit SHA is exactly 40 hex.
RAILWAY_GIT_COMMIT_SHA=
RAILWAY_DEPLOYMENT_ID=
RAILWAY_SERVICE_ID=
# Private metadata endpoint bearer token (minimum 32 characters in production).
AUTHORIZATION_METADATA_TOKEN=
# Required as one complete tuple only for a separately approved capability_only cutover.
AUTHORIZATION_EVIDENCE_PATH=
AUTHORIZATION_EVIDENCE_PUBLIC_KEY_B64=
AUTHORIZATION_EVIDENCE_KEY_ID=
AUTHORIZATION_SECURITY_APPROVAL_PUBLIC_KEY_B64=
AUTHORIZATION_SECURITY_APPROVAL_KEY_ID=
AUTHORIZATION_RELEASE_APPROVAL_PUBLIC_KEY_B64=
AUTHORIZATION_RELEASE_APPROVAL_KEY_ID=
AUTHORIZATION_CUTOVER_APPROVAL_PUBLIC_KEY_B64=
AUTHORIZATION_CUTOVER_APPROVAL_KEY_ID=
