{
  "name": "emaslaxat-api",
  "version": "1.0.0",
  "description": "eMaslaxat Legal Platform - Production API",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:sync": "node src/scripts/syncDatabase.js",
    "db:seed": "node src/seeds/index.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:locked": "node src/scripts/runMigrationsLocked.js",
    "db:predeploy": "node src/scripts/runMigrationsLocked.js",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "storage:migrate": "node src/scripts/migrateUploadsToR2.js",
    "storage:reconcile": "node src/scripts/reconcileObjectStorage.js",
    "storage:cleanup": "node src/scripts/processObjectCleanupTasks.js",
    "authorization:evidence": "node src/scripts/authorizationEvidence.js",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@aws-sdk/client-s3": "3.1113.0",
    "@aws-sdk/s3-request-presigner": "3.1113.0",
    "@sentry/node": "10.70.0",
    "@smithy/node-http-handler": "4.11.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^10.9.1",
    "helmet": "^7.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "9.0.5",
    "otplib": "^12.0.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "redis": "^4.6.12",
    "sequelize": "^6.35.2",
    "sequelize-cli": "6.6.5",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
