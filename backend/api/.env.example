# eMaslaxat API Configuration
# Copy to .env and fill in values

# Server
NODE_ENV=production
PORT=3001

# Database (PostgreSQL)
# Use DATABASE_URL, or provide the complete DB_* tuple below (never a partial tuple).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_HOST=postgres
DB_PORT=5432
DB_NAME=emaslaxat
DB_USER=emaslaxat_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD
# Set 1 only when TLS is required and DATABASE_URL does not already use sslmode=require.
DB_SSL=0
# Advisory migration lock controls: wait 0..600000 ms; poll 1..10000 ms.
MIGRATION_LOCK_WAIT_MS=120000
MIGRATION_LOCK_POLL_MS=1000
MIGRATION_BACKUP_EVIDENCE_B64=
MIGRATION_BACKUP_EVIDENCE_SIGNATURE_B64=
MIGRATION_BACKUP_EVIDENCE_PUBLIC_KEY_B64=
MIGRATION_BACKUP_EVIDENCE_KEY_ID=
MIGRATION_BACKUP_EXPECTED_CLUSTER_ID=
MIGRATION_BACKUP_MAX_AGE_SECONDS=3600

# Redis
REDIS_URL=redis://redis:6379
# Non-production only: explicitly allow an in-memory profile-import limiter when Redis is absent.
# Production always fails closed regardless of this value.
PROFILE_IMPORT_RATE_LIMIT_FALLBACK=disabled
# Socket.io Redis-адаптер: 1 — включить (нужно ТОЛЬКО при деплое на >1 инстанс бэкенда).
# По умолчанию выключено; одиночный инстанс работает без него.
SOCKET_REDIS=0

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_256_BIT_SECRET
JWT_EXPIRES_IN=7d

# CORS (your domain)
CORS_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN

# Sponsored catalog integrity keys (use independent random 256-bit values in production).
CATALOG_CURSOR_SECRET=CHANGE_ME_RANDOM_256_BIT_SECRET
CATALOG_ATTRIBUTION_SECRET=CHANGE_ME_RANDOM_256_BIT_SECRET
# Enable only when frontend/API are truly cross-site and both are served over HTTPS.
# Forces the actor cookie to SameSite=None; Secure is always enforced in this mode.
CATALOG_COOKIE_CROSS_SITE=0

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Sentry backend runtime. Use a dedicated backend project; never reuse the frontend DSN.
SENTRY_BACKEND_DSN=
SENTRY_ENVIRONMENT=production
# Railway's deployed commit SHA is declared once in the authorization runtime identity section below.

# File Upload
MAX_FILE_SIZE=10485760
# ВАЖНО для облака (Railway/Render): локальный диск ЭФЕМЕРНЫЙ — аватары и документы
# пропадут при каждом редеплое. Смонтируй Volume и укажи его путь здесь, напр.:
#   UPLOAD_DIR=/data/uploads   (Railway: Service → Volumes → Mount path /data)
UPLOAD_DIR=./uploads

# Private Cloudflare R2 storage for profile imports. Keep the bucket private and use
# credentials scoped to this bucket only; never configure an r2.dev/public URL.
R2_ACCOUNT_ID=CHANGE_ME_ACCOUNT_ID
R2_ACCESS_KEY_ID=CHANGE_ME_SCOPED_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CHANGE_ME_SCOPED_SECRET_ACCESS_KEY
R2_PRIVATE_BUCKET=CHANGE_ME_PRIVATE_BUCKET
# Declarative contract only: configure the matching ai-temp/ lifecycle rule in R2.
R2_AI_TEMP_LIFECYCLE_DAYS=1
# Stable secret used only to sign resumable storage-migration checkpoints (minimum 32 chars).
STORAGE_MIGRATION_CHECKPOINT_KEY=CHANGE_ME_32_CHAR_CHECKPOINT_HMAC_KEY
# Persistent writes always include R2. Use dual only during migration when a durable
# local volume is mounted; local fallback is disabled by default in production.
FILE_STORAGE_WRITE_MODE=r2
FILE_STORAGE_LOCAL_FALLBACK=false
FILE_STORAGE_LOCAL_ROOT=/data/uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Строгий положительный лимит на /api/auth; production default is 20.
AUTH_RATE_LIMIT_MAX=20

# Payme (получить на merchant.payme.uz). PAYME_KEY обязателен: пустое значение и
# CHANGE_ME/sk-CHANGE_ME отключают webhook (HTTP 503). Тестовый /payments/simulate
# доступен ТОЛЬКО при NODE_ENV!=production.
PAYME_KEY=CHANGE_ME
PAYME_MERCHANT_ID=CHANGE_ME
# legacy or shadow. Shadow requires complete PAYME_* credentials. Active remains
# deliberately rejected until successful staging observation, reconciliation, and approval.
PAYMENT_V2_MODE=legacy
# Evidence signing keys never belong in the application runtime. The protected evidence workflow
# uses an offline Ed25519 private key and a separate public verification key (see Payme runbook).

# SMTP (реальная почта; без него письма сброса/верификации не доходят — Ethereal только в dev)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
# Set true only for an explicit STARTTLS policy on a non-secure transport (normally port 587).
SMTP_REQUIRE_TLS=true
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@your-domain

# Публичный адрес фронта (ссылки в письмах: сброс пароля, верификация)
FRONTEND_URL=https://YOUR_DOMAIN

# SMS-провайдер для входа/регистрации по телефону (одноразовый код).
# Без ключей код НЕ отправляется реально: в dev возвращается в ответе (devCode),
# в проде phone/request вернёт ошибку. SMS_PROVIDER=eskiz|playmobile (или пусто = автоопределение).
SMS_PROVIDER=eskiz
# — Eskiz.uz: регистрация на eskiz.uz, логин = e-mail аккаунта, пароль = API-пароль из ЛК.
#   ESKIZ_FROM — одобренный отправитель (по умолчанию тестовый 4546; для боевых текстов
#   нужен согласованный шаблон/никнейм). Пароль — секрет, только через хранилище платформы.
ESKIZ_EMAIL=you@example.com
ESKIZ_PASSWORD=CHANGE_ME
ESKIZ_FROM=4546
# ESKIZ_BASE_URL=https://notify.eskiz.uz/api
# — Play Mobile (альтернатива): SMS_PROVIDER=playmobile
# PLAYMOBILE_URL=http://91.204.239.44/broker-api/send
# PLAYMOBILE_LOGIN=CHANGE_ME
# PLAYMOBILE_PASSWORD=CHANGE_ME
# PLAYMOBILE_FROM=3700

# TURN-сервер для видеозвонков (за реальными NAT публичного STUN мало).
# Свой authenticated TURN (напр. coturn) — иначе видео нестабильно.
TURN_URL=turn:YOUR_TURN_HOST:3478
TURN_USERNAME=CHANGE_ME
TURN_CREDENTIAL=CHANGE_ME

# Web-push (VAPID). Сгенерировать пару:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Приватный ключ — секрет, только через хранилище секретов платформы.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain

# Соц-вход (необязательно; без ключей кнопки скрыты).
# Google: console.cloud.google.com → OAuth client (Web) → сюда client_id.
GOOGLE_CLIENT_ID=
# Telegram: @BotFather → токен бота и его username (без @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Authorization stays in compatibility mode until the complete signed cutover runbook gate passes.
AUTHORIZATION_MODE=compatibility
# Production requires this complete Railway/build tuple; commit SHA is exactly 40 hex.
RAILWAY_GIT_COMMIT_SHA=
RAILWAY_DEPLOYMENT_ID=
RAILWAY_SERVICE_ID=
AUTHORIZATION_METADATA_TOKEN=
# capability_only additionally requires the private verified manifest and public verification keys:
AUTHORIZATION_EVIDENCE_PATH=
AUTHORIZATION_EVIDENCE_PUBLIC_KEY_B64=
AUTHORIZATION_EVIDENCE_KEY_ID=
AUTHORIZATION_SECURITY_APPROVAL_PUBLIC_KEY_B64=
AUTHORIZATION_SECURITY_APPROVAL_KEY_ID=
AUTHORIZATION_RELEASE_APPROVAL_PUBLIC_KEY_B64=
AUTHORIZATION_RELEASE_APPROVAL_KEY_ID=
AUTHORIZATION_CUTOVER_APPROVAL_PUBLIC_KEY_B64=
AUTHORIZATION_CUTOVER_APPROVAL_KEY_ID=
