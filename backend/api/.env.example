# eMaslaxat API Configuration
# Copy to .env and fill in values

# Server
NODE_ENV=production
PORT=3001

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=emaslaxat
DB_USER=emaslaxat_user
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_256_BIT_SECRET
JWT_EXPIRES_IN=7d

# CORS (your domain)
CORS_ORIGINS=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
